{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PulseInput",
  "type": "object",
  "properties": {
    "source": {
      "type": "object",
      "properties": {
        "patient_id": {"type": "string"},
        "device_id": {"type": "string"},
        "acquisition_time": {"type": "string"},
        "checksum": {"type": "object"}
      }
    },
    "channels": {
      "type": "object",
      "patternProperties": {
        ".*": {
          "type": "object",
          "properties": {
            "position": {"type": "string"},
            "waveform": {"type": "array", "items": {"type": "number"}}
          }
        }
      }
    }
  },
  "required": ["source", "channels"]
}
