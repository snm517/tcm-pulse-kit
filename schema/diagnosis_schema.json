{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DiagnosisReport",
  "type": "object",
  "properties": {
    "overall_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "shibian": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "position": {"type": "string"},
          "state": {"type": "string"},
          "confidence": {"type": "number"}
        }
      }
    },
    "quality_flags": {
      "type": "array",
      "items": {"type": "string"}
    },
    "pathogenesis_chains": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "required": ["overall_confidence", "shibian", "quality_flags"]
}
